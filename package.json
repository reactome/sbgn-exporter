{
  "name": "sbgn-exporter",
  "version": "0.0.0",
  "private": true,
  "description": "SBGN-ML (Process Description) export of Reactome events, for the website and the release's bulk download.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "neo4j-driver": "6.3.0",
    "prettier": "3.9.10",
    "saxes": "6.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
